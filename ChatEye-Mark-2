import numpy as np
import os
import cv2
from PIL import Image
import torch as tch
import torch.nn as nn
import torchvision.transforms as T

##Model name: ChatEye##

#SETTINGS 
epochs = 150
batch_size = 32
Dataset = "DATASET"
Image_list = []
File_list = os.listdir(Dataset)
Camera = cv2.VideoCapture(0)

augment = T.Compose([
    T.Resize((64, 64)),
    T.RandomHorizontalFlip(p=0.5),
    T.RandomVerticalFlip(p=0.2),
    T.RandomRotation(degrees=30),
    T.ColorJitter(brightness=0.3, contrast=0.3, saturation=0.3),
    T.ToTensor(),
    T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
])

cam_transform = T.Compose([
    T.Resize((64, 64)),
    T.ToTensor(),
    T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
])

#DATA TRAINING
Label_list = [] 
for Images in File_list:
    if Images.endswith((".jfif", ".png", ".jpeg", ".jpg")):
        Full_path = os.path.join(Dataset, Images)

        if Images.lower().startswith("cat"):
            Label = 0
        elif Images.lower().startswith("human"):
            Label = 1
        elif Images.lower().startswith("pencil"):
            Label = 2
        elif Images.lower().startswith("bottle"):
            Label = 3
        elif Images.lower().startswith("phone"):
            Label = 4
        elif Images.lower().startswith("laptop"):
            Label = 5
        else:
            continue

        img = Image.open(Full_path)
        img_rgb = img.convert("RGB")

        for _ in range(6):
            img_tensor = augment(img_rgb)
            Image_list.append(img_tensor)
            Label_list.append(Label)
Pytorch_Dataset = tch.stack(Image_list)
Labels = tch.tensor(Label_list, dtype=tch.long)

indices = tch.randperm(Pytorch_Dataset.size(0))
Pytorch_Dataset = Pytorch_Dataset[indices]
Labels = Labels[indices]

#ChatEye brain
class ChatEye(nn.Module):
    def __init__(self):
        super(ChatEye, self).__init__()

        self.conv1 = nn.Conv2d(3, 32, kernel_size = 3, padding = 1)
        self.bn1 = nn.BatchNorm2d(32)

        self.conv2 = nn.Conv2d(32, 64, kernel_size = 3, padding = 1)
        self.bn2 = nn.BatchNorm2d(64)

        self.pool = nn.MaxPool2d(2, 2)
        self.dropout = nn.Dropout(0.50)
        self.fc = nn.Linear(64 * 16 * 16, 6)

    def forward(self, x):
        x = self.conv1(x)
        x = self.bn1(x)
        x = tch.relu(x)
        x = self.pool(x)
        
        x = self.conv2(x)
        x = self.bn2(x)
        x = tch.relu(x)
        x = self.pool(x)
        
        x = self.dropout(x)
        
        x = x.reshape(x.size(0), -1)
        x = self.fc(x)
        return x

model = ChatEye()

optimizer = tch.optim.AdamW(model.parameters(), lr=0.0001, weight_decay = 0.01)
criterion = nn.CrossEntropyLoss()
print(model)

#TRAINING 
for epoch in range(epochs):
    model.train()

    epoch_loss = 0.0
    total_batches = 0

    permutation = tch.randperm(Pytorch_Dataset.size(0))

    for i in range(0, Pytorch_Dataset.size(0), batch_size):
        optimizer.zero_grad(set_to_none = True)

        indices = permutation[i:i + batch_size]
        batch_x = Pytorch_Dataset[indices]
        batch_y = Labels[indices]

        logits = model(batch_x)
        Loss = criterion(logits, batch_y)
        
        Loss.backward()
        optimizer.step()

        epoch_loss += Loss.item()
        total_batches += 1


    if epoch % 25 == 0:
        Average_loss = epoch_loss / total_batches
        print(f"Epoch {epoch:03d}/{epochs}, Average loss: {Average_loss:.4f}")

tch.save(model.state_dict(), "CV MEMORY/ChatEye.pt")
print("ChatEye BRAIN has been trained and saved!")

model.eval()

label_name = {
    0: "Cat",
    1: "Human",
    2: "Pencil",
    3: "Bottle",
    4: "Phone",
    5: "Laptop"
}

#CAMERA 
while True:
    Success, CV = Camera.read()
    if not Success:
        print("No camera detected!")
        break
    Frame_rgb = cv2.cvtColor(CV, cv2.COLOR_BGR2RGB)
    Img_pil = Image.fromarray(Frame_rgb)
    Img_tensor = cam_transform(Img_pil).unsqueeze(0)

    with tch.no_grad():
        outputs = model(Img_tensor)
        ID_Guess = tch.argmax(outputs, dim=1).item()
        Text_Decided = label_name[ID_Guess]

        cv2.putText(CV, f"ChatEye Cam: {Text_Decided}", (30, 50), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)

    cv2.imshow("ChatEye", CV)
    if cv2.waitKey(1) & 0xFF == ord('x'):
        break
    

Camera.release()
cv2.destroyAllWindows()
